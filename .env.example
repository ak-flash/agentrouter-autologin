# Учётные данные agentrouter.org
AGENTROUTER_EMAIL=your_email@example.com
AGENTROUTER_PASSWORD=your_password_here

# Необязательный прокси для Chrome: http://, https:// или socks5://
# Пример с авторизацией: http://user:password@host:port
PROXY=

# Режим отладки: true = сохранять HTML страниц в pages/ и писать подробный лог,
# false = в лог только успешный вход и значение баланса
DEBUG=false

# Минимальный интервал между успешными запусками, в секундах (по умолчанию 86400 = 24ч).
# При частых cron-запусках скрипт пропускает запуск, если вход уже удался за этот период.
MIN_INTERVAL_SEC=86400
